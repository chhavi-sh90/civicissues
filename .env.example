# =====================================================================
# Civic Connect Backend — Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit your actual ".env" file (it's in .gitignore).
# =====================================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MySQL Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=civic_connect
DB_CONNECTION_LIMIT=10

# --- JWT Authentication ---
# Use a long, random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=10

# --- CORS ---
# Comma-separated list of allowed origins for your Flutter/React clients
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- File Uploads ---
# "local" stores files in the /uploads folder and serves them statically.
# "cloud" requires the CLOUD_* variables below (e.g. AWS S3-compatible).
UPLOAD_STRATEGY=local
MAX_UPLOAD_SIZE_MB=5
LOCAL_UPLOAD_DIR=uploads

# --- Cloud Storage (only required if UPLOAD_STRATEGY=cloud) ---
# Example shown for an S3-compatible bucket. Leave blank to use local storage.
CLOUD_STORAGE_PROVIDER=
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_REGION=
CLOUD_STORAGE_ACCESS_KEY_ID=
CLOUD_STORAGE_SECRET_ACCESS_KEY=
CLOUD_STORAGE_PUBLIC_URL_BASE=

# --- Google Maps API (used client-side for map display; backend only
#     validates lat/lng ranges, so this key is optional server-side
#     unless you add server-side geocoding/reverse-geocoding later) ---
GOOGLE_MAPS_API_KEY=

# --- Firebase Cloud Messaging (push notifications) ---
# Leave these blank to run in "not_configured" fallback mode: the API
# will log notifications instead of sending real pushes, and will be
# honest about it in the response (delivery_status = 'not_configured').
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- AI/ML categorization (optional) ---
# If left blank, the system uses the built-in rule-based categorizer
# (keyword matching against category names). Set to a reachable HTTP
# endpoint of your own trained model to enable ML-based categorization.
ML_CATEGORIZATION_ENDPOINT=
